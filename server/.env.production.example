# Copiez ce fichier en ".env" sur votre hébergeur de production et adaptez les valeurs.
# NE JAMAIS committer le vrai fichier ".env" avec de vraies valeurs dans Git.

# Base de données : en production, utiliser PostgreSQL plutôt que SQLite (voir DEPLOYMENT.md
# pour pourquoi). Format fourni par votre hébergeur de base de données.
DATABASE_URL=postgresql://user:password@host:5432/nom_de_la_base

# Clé secrète JWT — générez-en une nouvelle et unique pour la production.
# Exemple pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-vraie-cle-secrete-aleatoire

# Port fourni automatiquement par la plupart des hébergeurs (Railway, Render, Fly.io) —
# laissez tel quel sauf indication contraire de votre hébergeur.
PORT=3000

# Domaine(s) du client déployé, séparés par des virgules, sans slash final.
ALLOWED_ORIGINS=https://votre-jeu.exemple.com
