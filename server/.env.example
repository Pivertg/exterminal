# Copiez ce fichier en ".env" et adaptez les valeurs

# URL de connexion PostgreSQL. En développement, utilisez soit une base Postgres locale,
# soit directement l'URL publique de votre base Railway (le plus simple pour ce projet —
# voir docs/DEPLOYMENT.md).
DATABASE_URL=postgresql://user:password@host:5432/nom_de_la_base

# Clé secrète utilisée pour signer les JWT — à changer en production
JWT_SECRET=changez-moi-en-production

# Port du serveur
PORT=3000
